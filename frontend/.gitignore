# =========================================
# 🔹 Global ignores (both frontend & backend)
# =========================================
node_modules/
dist/
build/
.cache/
.tmp/
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# =========================================
# 🔹 Environment and credentials
# =========================================
.env
.env.*
!.env.example
firebase-debug.log
serviceAccountKey.json

# =========================================
# 🔹 Frontend (React)
# =========================================
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.pnp/
frontend/.pnp.js
frontend/coverage/
frontend/.vite/
frontend/.parcel-cache/
frontend/.next/
frontend/.vercel/

# =========================================
# 🔹 Backend (Node.js)
# =========================================
backend/node_modules/
backend/.env
backend/serviceAccountKey.json
backend/coverage/
backend/logs/
backend/debug.log
backend/error.log

# =========================================
# 🔹 Yarn and lock files
# =========================================
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarnrc.yml
yarn.lock

# =========================================
# 🔹 Firebase / Cloud / Hosting
# =========================================
.firebase/
.firebaserc
storage-debug.log
firebase.json
.firestore.indexes.json
.firestore.rules

# =========================================
